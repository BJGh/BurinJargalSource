Get-ChildItem -Path ".\app\legion" -Filter "*.h" -Recurse | Remove-Item -Force
Console.WriteLine("[Pipeline] Все C++ заголовки успешно удалены.")

Get-ChildItem -Path ".\app\legion" -Filter "*.cpp" -Recurse | ForEach-Object {
    $cppContent = Get-Content $_.FullName -Raw
    
    # Запрос к локальному MCP Dart серверу на трансляцию в C# .NET 10
    $uri = "http://localhost:8080/mcp/translate"
    $body = @{ lang = "csharp10"; code = $cppContent } | ConvertTo-Json
    $response = Invoke-RestMethod -Uri $uri -Method Post -Body $body -ContentType "application/json"
    
    # Сохраняем "прошитый" C# файл в проект SourceSharp
    $newFileName = $_.Name -replace '\.cpp$', '.cs'
    $targetPath = Join-Path ".\sourcesharp\app\legion" $newFileName
    Set-Content -Path $targetPath -Value $response.translatedCode
    
    Write-Host "[MCP-Dart] Файл $($_.Name) успешно переписан в $newFileName"
}

# 3. Финальный пуш компиляции в Native AOT
dotnet build .\sourcesharp\sourcesharp.csproj -c Release
